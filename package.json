{
  "name": "@rdlabo/capacitor-workers",
  "version": "0.0.0-poc.1",
  "license": "MIT",
  "description": "Run Workers fetch handlers inside Capacitor WebViews",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./features": {
      "types": "./dist/features/index.d.ts",
      "import": "./dist/features/index.js"
    },
    "./testing": {
      "types": "./dist/features/testing.d.ts",
      "import": "./dist/features/testing.js"
    },
    "./features/fetch": {
      "types": "./dist/features/fetch.d.ts",
      "import": "./dist/features/fetch.js"
    },
    "./features/kv": {
      "types": "./dist/features/kv/index.d.ts",
      "import": "./dist/features/kv/index.js"
    },
    "./testing/fetch": {
      "types": "./dist/testing/fetch.d.ts",
      "import": "./dist/testing/fetch.js"
    },
    "./testing/kv": {
      "types": "./dist/testing/kv.d.ts",
      "import": "./dist/testing/kv.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:package": "node scripts/test-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "vite-plugin-node-polyfills": "^0.28.0",
    "node-stdlib-browser": "^1.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "prettier": "^3.8.4",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "esbuild": "^0.28.2",
    "vite": "^7.3.7"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
