{
  "name": "@rdlabo/capacitor-workers",
  "version": "0.0.0-poc.1",
  "description": "Run Workers fetch handlers inside Capacitor WebViews",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./features": {
      "types": "./dist/features/index.d.ts",
      "import": "./dist/features/index.js"
    },
    "./testing": {
      "types": "./dist/features/testing.d.ts",
      "import": "./dist/features/testing.js"
    },
    "./features/fetch": {
      "types": "./dist/features/fetch.d.ts",
      "import": "./dist/features/fetch.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:package": "node scripts/test-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "prettier": "^3.8.4",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
