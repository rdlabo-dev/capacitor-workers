{
  "name": "capacitor-workers-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "sync": "cap sync",
    "ios": "cap run ios",
    "android": "cap run android",
    "test:browser": "playwright test",
    "test:workers": "vitest run",
    "build:experiment": "vite build --config experiments/dedicated-worker/vite.config.ts",
    "test:experiment": "npm run build:experiment && playwright test --config playwright.experiment.config.ts",
    "preview:experiment": "vite preview --config experiments/dedicated-worker/vite.config.ts --host 127.0.0.1 --port 4181 --strictPort"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@rdlabo/capacitor-workers": "file:..",
    "express": "^5.3.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "cf": "^1.0.0-beta.17",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  }
}
